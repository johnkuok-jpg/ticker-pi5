# Display geometry for two 64x32 panels chained horizontally.
TICKER_WIDTH=128
TICKER_HEIGHT=32
TICKER_ADDR_LINES=4
TICKER_BRIGHTNESS=0.35
# Brightness schedule: comma-separated "[days ]HH:MM=level" steps. Levels are a
# 0-1 fraction, a 0-100 percentage, or "off". Days accept mon..sun, ranges like
# mon-fri (which may wrap, e.g. fri-mon), weekday, weekend, or all; omit them to
# mean every day. Because commas separate steps, a day list cannot contain one.
# The level in force is the most recent step that has passed, so there are no
# gaps and no need to define an end time. Leave blank for a fixed brightness.
# The web slider overrides the schedule until the next step, then it resumes.
TICKER_BRIGHTNESS_SCHEDULE=mon-fri 06:30=45, mon-fri 09:00=70, sat-sun 08:30=55, 18:30=45, 21:30=20, 23:00=8
TICKER_FPS=30

# Comma-separated Yahoo Finance symbols. BTC-USD is supported.
TICKER_SYMBOLS=MU,SPY,NVDA

# Stocks layout: card (one big symbol, rotating) or scroll (classic marquee).
STOCKS_LAYOUT=card

# News RSS feed.
NEWS_FEED_URL=https://search.cnbc.com/rs/search/combinedcms/view.xml?partnerId=wrss01&id=20910258
NEWS_SOURCE_NAME=CNBC MARKETS

# NWS weather location. Set these to the display's location.
WEATHER_LAT=37.7749
WEATHER_LON=-122.4194
WEATHER_USER_AGENT=ticker-pi5 (github.com/johnkuok-jpg/ticker-pi5)

# Clock shown in weather mode. Blank uses the Pi's system timezone.
TICKER_TIMEZONE=America/Los_Angeles
TICKER_CLOCK_24H=false

# Flight tracking. The flights mode follows one airline flight number and shows
# the airline, an estimated landing time, and a progress bar along the route.
# Either IATA or ICAO form works: UA889 and UAL889 are the same flight.
# Leaving this blank is fine - the web app can set it at any time, and whatever
# is set there wins over this value.
FLIGHT_NUMBER=

# Coins for the crypto mode, quoted in USD. Up to three fit on the panel: two
# are shown in 6x12 type, a third drops all rows to 5x8. Any Coinbase USD spot
# product works, e.g. BTC,ETH,SOL.
CRYPTO_SYMBOLS=BTC,ETH

# Home station for the BART departure board, as a four-letter BART abbreviation
# (EMBR, MCAR, DUBL, 12TH and so on). The web app has a dropdown of all fifty
# stations and whatever is picked there wins over this value.
BART_STATION=EMBR

# Color channel order the panels expect. Leave as rgb unless colors look wrong.
# Run scripts/check_colors.py: if yellow and pink trade places, use rbg
# (green and blue swapped). Any permutation of rgb is accepted.
TICKER_CHANNEL_ORDER=rgb

# Fallback Wi-Fi setup hotspot, used when no known network is in range.
# Leave the password unset to have one generated once and shown on the panel.
WIFI_SETUP_SSID=TICKER-SETUP
# WIFI_SETUP_PASSWORD=
