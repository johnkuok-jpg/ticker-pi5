# Display geometry for two 64x32 panels chained horizontally.
TICKER_WIDTH=128
TICKER_HEIGHT=32
TICKER_ADDR_LINES=4
TICKER_BRIGHTNESS=0.35
TICKER_FPS=30

# Comma-separated Yahoo Finance symbols. BTC-USD is supported.
TICKER_SYMBOLS=MU,SPY,NVDA

# Stocks layout: card (one big symbol, rotating) or scroll (classic marquee).
STOCKS_LAYOUT=card

# News RSS feed.
NEWS_FEED_URL=https://search.cnbc.com/rs/search/combinedcms/view.xml?partnerId=wrss01&id=20910258
NEWS_SOURCE_NAME=CNBC MARKETS

# NWS weather location. Set these to the display's location.
WEATHER_LAT=37.7749
WEATHER_LON=-122.4194
WEATHER_USER_AGENT=ticker-pi5 (github.com/johnkuok-jpg/ticker-pi5)

# Optional fallback file when no MPRIS service is available.
RASPOTIFY_LOG_PATH=/var/log/raspotify/raspotify.log

# Clock shown in weather mode. Blank uses the Pi's system timezone.
TICKER_TIMEZONE=America/Los_Angeles
TICKER_CLOCK_24H=false
